/* [wxMaxima: comment start ]
An application document for Geometric Algebra using wxMaxima

Use of ctensor functions with the stationary spherical Kerr metric from Kerr_metrics.pdf
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
Use of ctensor functions ct_coords()  ratchristof() and christof() only

'manual' calculation of affine connections with the rotating spherical Kerr metric from Kerr_metrics.pdf
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
Initialization
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
ext:["wxm"]$
file_type_maxima:append(ext,file_type_maxima)$
batchload("initialize_fns")$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
the pseudoscalar and its inverse
the lowest useable dimension pseudoscalar should be {e1,e2} i.e. Plen = 2
e.g. for four dimensions edit Pseudos:{e1,e2,e3}$ to Pseudos:{e1,e2,e3,e4}$
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
Pseudos:{e1,e2,e3,e4}$
Pvar:listofvars(Pseudos)$
Plen:length(Pvar)$
I:Pseudos$
ni:(Plen-1)*Plen/2$
Ii:(-1)^ni*I$
kill(ni)$
ldisplay(Pvar)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
batchload("initialize_lsts")$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
end of Initialization
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
set derivabbrev:false$
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
derivabbrev:false$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
ratprint:false$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
Start of tensor analysis for rotating kerr metric
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
load(ctensor)$
init_ctensor()$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
ct_coords:[r,theta,phi,t];
dim;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
declare(a,real,m,real);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
the covariant metric tensor
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
file_search_maxima;
batch("Kerr_1963_subcode")$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
matrixp(lg);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
the contravariant metric tensor
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
ug:invert_by_lu(lg)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
matrixp(ug);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
derivabbrev:true$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
the Christoffel tensor of the second kind, the third index is the contravariant index of the tensor array; 
the equivalence of the manual array code and the ctensor code for the Christoffel tensor 2nd) was shown in the filenamed christ_symm_stat.wxm
rational simplification
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
ratchristof:true$
christof(mcs)$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
unused: to find gdet from ctensor...equivalent to detg below
cframe_flag is false or cframe_flag:false$
cframe_flag:false$
cmetric()$
ldisplay(gdet)$
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
determinant(lg)$
trigsimp(%)$
detg:factor(%)$
rtmg:sqrt(-detg)$
ldisplay(detg,rtmg)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
start of manual tensor arrays (indexed 0...3) and matrix calculations
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
dimarr:3$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
 lg:trigsimp(lg); but lg is simple enough
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
Llg:list_matrix_entries(lg)$
array(lgarr,dimarr,dimarr)$
fillarray(lgarr,Llg)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
it is ug that is complicated
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
ug:trigsimp(ug);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Lug:list_matrix_entries(ug)$
array(ugarr,dimarr,dimarr)$
fillarray(ugarr,Lug)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
for amu:0 thru dimarr do
block(
for anu:0 thru dimarr do
block(
ldisplay(ugarr[amu,anu])
))$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
ugnum:matrixmap(num,ug)$
ugden:matrixmap(denom,ug)$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
Lug:list_matrix_entries(ugnum)$
array(ugnumarr,dimarr,dimarr)$
fillarray(ugnumarr,Lug)$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
for amu:0 thru dimarr do
block(
for anu:0 thru dimarr do
block(
ldisplay(ugnumarr[amu,anu])
))$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
Lug:list_matrix_entries(ugden)$
array(ugdenarr,dimarr,dimarr)$
fillarray(ugdenarr,Lug)$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
for amu:0 thru dimarr do
block(
for anu:0 thru dimarr do
block(
ldisplay(ugdenarr[amu,anu])
))$
   [wxMaxima: comment end   ] */


/* [wxMaxima: comment start ]
tensorkill;
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
Lx:[r,theta,phi,t];
array(xarr,dimarr)$
fillarray(xarr,Lx)$
xarr[3];
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
arrays;
listarray(nbases);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
calculation of the Cristoffel symbol (2nd) for the early rotating Kerr metric
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
array(ch_symm,dimarr,dimarr,dimarr)$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
for amu:0 thru dimarr do
block(
for anu:0 thru dimarr do
block(
for asig:0 thru dimarr do
block(
asum:0,
for alph:0 thru dimarr do
block(
asum:asum+1/2*ugarr[asig,alph]*( diff(lgarr[anu,alph],xarr[amu]) + diff(lgarr[alph,amu],xarr[anu]) - diff(lgarr[amu,anu],xarr[alph]) )
),
ch_symm[amu,anu,asig]:trigsimp(asum)  )
))$
/* [wxMaxima: input   end   ] */


/* [wxMaxima: comment start ]
ch_symm[amu,anu,asig]:trigsimp(asum/2)  )
   [wxMaxima: comment end   ] */


/* [wxMaxima: input   start ] */
for amu:0 thru dimarr do
block(
for anu:0 thru dimarr do
block(
for asig:0 thru dimarr do
block(
ldisplay(ch_symm[amu,anu,asig])
)))$
/* [wxMaxima: input   end   ] */



